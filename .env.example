PREFIX=!
# Your number with country code, no + (e.g. 919876543210) - enables owner-only commands
OWNER_NUMBER=
# Set true to let the bot respond to your own messages (handy for testing in "Message yourself")
ALLOW_SELF=false
# Optional free AI via Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TIMEZONE=Asia/Kolkata
